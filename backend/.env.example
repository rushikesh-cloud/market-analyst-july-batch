# Add these settings to the root .env (loaded by npm run dev).
# The issuer is your Clerk Frontend API URL, not your application URL.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:8000
# Approved users share the existing companies and documents.
CLERK_ACCESS_MODE=approved_users
CLERK_ALLOWED_USER_IDS=
